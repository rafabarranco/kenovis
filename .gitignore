# =============================================================
# UNIVERSAL — applies to every product. Do not remove.
# =============================================================

# Secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/
vendor/
.venv/
venv/
__pycache__/

# Build outputs
dist/
build/
out/

# Testing / coverage
coverage/
.pytest_cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Credentials and signing material
*.pem
*.key
*.jks
*.p8
*.p12
*.mobileprovision

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
*.swp

# Misc
*.tsbuildinfo
.eslintcache

# Graphify knowledge graph — regenerate locally with `graphify extract .`
# (can exceed the 512MiB graph.json cap on large repos; never versioned)
graphify-out/

# =============================================================
# STACK-SPECIFIC — PROJECT-SPECIFIC: keep only the blocks that
# match the stack chosen in ENGINEERING/ARCHITECTURE.md.
# Delete the rest. See AI/commands/init-project.md
# =============================================================

# Next.js
.next/

# Expo / React Native
# Warning: only ignore ios/ and android/ if the native directories
# are generated by prebuild and never edited by hand.
.expo/
.expo-shared/
ios/
android/

# Supabase
supabase/.branches
supabase/.temp
